{
  "name": "rivalt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "generate": "node --import tsx ops/generate-sdk.ts",
    "generate:check": "node --import tsx ops/generate-sdk.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:financial": "bash ops/financial.sh",
    "test:svm": "node --import tsx tests/rpc-contract/custody-svm.ts",
    "conformance": "node tests/anchor-conformance/conformance.cjs",
    "smoke": "bash ops/smoke.sh",
    "test:makers": "bash ops/makers.sh",
    "test:routes": "node --import tsx tests/rpc-contract/route-svm.ts",
    "indexer": "node --import tsx packages/indexer/src/main.ts",
    "test:settlement": "node --import tsx tests/rpc-contract/settlement-svm.ts",
    "services": "node --import tsx packages/services/src/main.ts",
    "test:oracle": "node --import tsx tests/rpc-contract/oracle-svm.ts",
    "test:orders": "node --import tsx tests/rpc-contract/order-svm.ts",
    "test:resolution": "bash ops/resolution-tests.sh",
    "build:trader": "pnpm --filter @rivalt/trader build",
    "trader": "pnpm --filter @rivalt/trader dev",
    "test:browser": "bash ops/browser-smoke.sh"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.8.0",
    "@types/node": "24.10.1",
    "codama": "1.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
