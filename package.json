{
  "name": "rivalt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "generate": "node --import tsx ops/generate-sdk.ts",
    "generate:check": "node --import tsx ops/generate-sdk.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:programs": "bash ops/build.sh",
    "test:financial": "bash ops/financial.sh",
    "test:makers": "bash ops/canonical-maker-smoke.sh",
    "test:custody": "bash ops/account-custody-smoke.sh",
    "test:routes": "bash ops/liquidity-execution-smoke.sh",
    "test:safety": "bash ops/liquidity-safety-smoke.sh",
    "test:publisher": "bash ops/funding-publisher-smoke.sh",
    "test:services": "bash ops/liquidity-services-smoke.sh",
    "test:browser": "bash ops/browser-smoke.sh",
    "smoke": "bash ops/smoke.sh",
    "indexer": "node --import tsx packages/indexer/src/main.ts",
    "services": "node --import tsx packages/services/src/account-service-main.ts",
    "build:trader": "pnpm --filter @rivalt/trader build",
    "trader": "pnpm --filter @rivalt/trader dev",
    "demo": "bash ops/demo.sh",
    "liquidity:bot": "node --import tsx packages/maker-kit/src/liquidity-bot.ts",
    "liquidity:report": "node --import tsx packages/maker-kit/src/liquidity-report.ts",
    "report:availability": "node --import tsx tests/load/availability-cli.ts"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.8.0",
    "@types/node": "24.10.1",
    "codama": "1.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
