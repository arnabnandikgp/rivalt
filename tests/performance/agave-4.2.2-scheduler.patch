diff --git a/core/src/banking_stage/transaction_scheduler/queue_trace.rs b/core/src/banking_stage/transaction_scheduler/queue_trace.rs
new file mode 100644
index 0000000..6a97bb2
--- /dev/null
+++ b/core/src/banking_stage/transaction_scheduler/queue_trace.rs
@@ -0,0 +1,67 @@
+//! Local qualification instrumentation. Format and write off the scheduler thread.
+use {
+    solana_runtime_transaction::transaction_with_meta::TransactionWithMeta,
+    solana_signature::Signature,
+    std::{
+        fs::File,
+        io::{BufWriter, Write},
+        sync::{
+            OnceLock,
+            mpsc::{RecvTimeoutError, Sender, channel},
+        },
+        time::{Duration, Instant},
+    },
+};
+
+struct Event {
+    micros: u128,
+    stage: &'static str,
+    id: usize,
+    signature: Signature,
+    worker: Option<usize>,
+}
+
+pub(crate) fn record<T: TransactionWithMeta>(
+    stage: &'static str,
+    id: usize,
+    transaction: &T,
+    worker: Option<usize>,
+) {
+    static TRACE: OnceLock<Option<(Instant, Sender<Event>)>> = OnceLock::new();
+    let Some((origin, sender)) = TRACE.get_or_init(|| {
+        let path = std::env::var_os("RIVALT_AGAVE_QUEUE_TRACE")?;
+        let file = File::create_new(path).expect("create new qualification trace");
+        let (sender, receiver) = channel::<Event>();
+        std::thread::spawn(move || {
+            let mut writer = BufWriter::new(file);
+            loop {
+                match receiver.recv_timeout(Duration::from_millis(100)) {
+                    Ok(event) => writeln!(
+                        writer,
+                        "{} {} {} {} {}",
+                        event.micros,
+                        event.stage,
+                        event.id,
+                        event.signature,
+                        event.worker.map_or_else(|| "-".into(), |w| w.to_string())
+                    )
+                    .unwrap(),
+                    Err(RecvTimeoutError::Timeout) => writer.flush().unwrap(),
+                    Err(RecvTimeoutError::Disconnected) => break,
+                }
+            }
+        });
+        Some((Instant::now(), sender))
+    }) else {
+        return;
+    };
+    sender
+        .send(Event {
+            micros: origin.elapsed().as_micros(),
+            stage,
+            id,
+            signature: *transaction.signature(),
+            worker,
+        })
+        .expect("trace consumer");
+}
